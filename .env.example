# SokoResult environment template — copy to .env and fill in.
# NEVER commit the real .env (it's gitignored).

# ── Supabase (Project Settings → API) ─────────────────────────────
# Project URL, e.g. https://abcdefghij.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=
# Publishable ("anon") key — safe for the browser
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# service_role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Project ref (the 20-char slug in the URL)
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=

# ── AI (Gemini — free key at https://aistudio.google.com/apikey) ──
# Used by lib/server/gemini.ts for sentiment + market suggestions.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=

# ── Scrapers (Apify — https://console.apify.com) ──────────────────
APIFY_API_TOKEN=

# ── Cron hooks (shared secret for /api/public/hooks/*) ────────────
CRON_SECRET=
