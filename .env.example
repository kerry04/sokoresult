# SokoResult environment template — copy to .env and fill in.
# NEVER commit the real .env (it's gitignored).

# ── Supabase (Project Settings → API) ─────────────────────────────
# Project URL, e.g. https://abcdefghij.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=
# Publishable ("anon") key — safe for the browser
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# service_role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Project ref (the 20-char slug in the URL)
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=

# ── Firebase (auth bridge for Supabase third-party auth) ──────────
# Values from Firebase console → Project settings → Your apps → SDK setup.
# Leave empty to disable the Firebase path (falls back to Supabase auth).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=


# ── Scrapers (Apify — https://console.apify.com) ──────────────────
APIFY_API_TOKEN=

# ── Cron hooks (shared secret for /api/public/hooks/*) ────────────
CRON_SECRET=
# ── LLM (OpenRouter — free key at https://openrouter.ai/settings/keys) ─
# Pipeline analysis model. Swap models by changing OPENROUTER_MODEL only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
